# Copy to .env. Never commit .env.
POSTGRES_USER=networth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=networth
DATABASE_URL=postgres://networth:change-me@localhost:5432/networth

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Production: your Tailscale hostname, e.g. https://networth.tailXXXX.ts.net
APP_ORIGIN=http://localhost:3000

# Bind Caddy to the Tailscale interface in production (ADR-0006).
BIND_ADDR=127.0.0.1

# Sign-in codes (email OTP) go out over SMTP, e.g. Gmail with an app password:
# SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NetWorth <you@example.com>"
# Staging only (DEMO_MODE=true): every code goes to this inbox; unset = no mail sent.
SMTP_DEMO_TO=

# MUST be true on Vercel staging, false at home.
DEMO_MODE=false
