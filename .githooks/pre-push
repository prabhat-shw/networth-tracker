#!/bin/sh
# Blocks direct pushes to main (ADR-0008). Work happens on branches, lands via PR.
# Enabled by: git config core.hooksPath .githooks
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
		refs/heads/main)
			echo "✗ Direct pushes to main are not allowed (ADR-0008)."
			echo "  Create a branch and open a PR:  git switch -c feat/your-change"
			exit 1
			;;
	esac
done
exit 0
